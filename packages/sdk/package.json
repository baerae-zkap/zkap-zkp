{
  "name": "@baerae/zkap-zkp",
  "version": "0.1.4",
  "description": "Node.js SDK for zkap-zkp. For browser (WebAssembly), use @baerae/zkap-zkp-wasm.",
  "main": "./dist/node.cjs",
  "module": "./dist/node.mjs",
  "types": "./dist/node.d.ts",
  "exports": {
    ".": {
      "types": "./dist/node.d.ts",
      "require": "./dist/node.cjs",
      "import": "./dist/node.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "zk",
    "groth16",
    "poseidon",
    "zkap",
    "bn254",
    "zero-knowledge"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baerae-zkap/zkap-zkp.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/baerae-zkap/zkap-zkp",
  "bugs": "https://github.com/baerae-zkap/zkap-zkp/issues",
  "license": "MIT OR Apache-2.0",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "dependencies": {
    "@baerae/zkap-zkp-node": "0.1.4"
  },
  "scripts": {
    "build": "tsup",
    "prepack": "npm run build",
    "test": "echo 'no tests — sdk is a pure re-export of @baerae/zkap-zkp-node'"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.5"
  }
}
