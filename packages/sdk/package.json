{
  "name": "@baerae/zkap-zkp",
  "version": "0.1.7",
  "description": "Compatibility facade for the zkap-zkp runtime SDK packages.",
  "main": "./dist/node.cjs",
  "module": "./dist/node.mjs",
  "types": "./dist/index.d.ts",
  "browser": "./dist/wasm.mjs",
  "react-native": "./dist/react-native.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/react-native.js",
      "browser": "./dist/wasm.mjs",
      "node": {
        "types": "./dist/node.d.ts",
        "import": "./dist/node.mjs",
        "require": "./dist/node.cjs"
      },
      "import": "./dist/wasm.mjs",
      "require": "./dist/node.cjs",
      "default": "./dist/wasm.mjs"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.mjs",
      "require": "./dist/node.cjs"
    },
    "./node-sync": {
      "types": "./dist/node-sync.d.ts",
      "import": "./dist/node-sync.mjs",
      "require": "./dist/node-sync.cjs"
    },
    "./wasm": {
      "types": "./dist/wasm.d.ts",
      "import": "./dist/wasm.mjs"
    },
    "./react-native": {
      "types": "./dist/react-native.d.ts",
      "react-native": "./dist/react-native.js",
      "default": "./dist/react-native.js"
    },
    "./package.json": {
      "default": "./package.json"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "zk",
    "groth16",
    "poseidon",
    "zkap",
    "bn254",
    "zero-knowledge"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baerae-zkap/zkap-zkp-sdk.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/baerae-zkap/zkap-zkp-sdk",
  "bugs": "https://github.com/baerae-zkap/zkap-zkp-sdk/issues",
  "license": "MIT OR Apache-2.0",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "peerDependencies": {
    "@baerae/zkap-zkp-node": "0.1.7",
    "@baerae/zkap-zkp-react-native": "0.1.7",
    "@baerae/zkap-zkp-wasm": "0.1.7",
    "expo-file-system": ">=17"
  },
  "peerDependenciesMeta": {
    "@baerae/zkap-zkp-node": {
      "optional": true
    },
    "@baerae/zkap-zkp-react-native": {
      "optional": true
    },
    "@baerae/zkap-zkp-wasm": {
      "optional": true
    },
    "expo-file-system": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsup",
    "prepack": "npm run build",
    "test": "npm run build"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.5"
  }
}
