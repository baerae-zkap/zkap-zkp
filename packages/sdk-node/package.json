{
  "name": "@baerae/zkap-zkp-node",
  "version": "0.1.0",
  "description": "Node.js native bindings for zkap-zkp (napi-rs)",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "*.node"
  ],
  "napi": {
    "binaryName": "zkap-zkp-node",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl"
    ]
  },
  "optionalDependencies": {
    "@baerae/zkap-zkp-node-darwin-x64": "0.1.0",
    "@baerae/zkap-zkp-node-darwin-arm64": "0.1.0",
    "@baerae/zkap-zkp-node-linux-x64-gnu": "0.1.0",
    "@baerae/zkap-zkp-node-linux-x64-musl": "0.1.0"
  },
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18"
  }
}
