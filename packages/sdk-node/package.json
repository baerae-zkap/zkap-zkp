{
  "name": "@baerae/zkap-zkp-node",
  "version": "0.1.0",
  "description": "Node.js native bindings for zkap-zkp (napi-rs)",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "*.node"
  ],
  "napi": {
    "binaryName": "zkap-zkp-node",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl"
    ]
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "zk",
    "groth16",
    "poseidon",
    "zkap",
    "napi",
    "native"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/baerae-zkap/zkap-zkp.git",
    "directory": "packages/sdk-node"
  },
  "homepage": "https://github.com/baerae-zkap/zkap-zkp",
  "bugs": "https://github.com/baerae-zkap/zkap-zkp/issues",
  "license": "MIT OR Apache-2.0",
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "test": "ava"
  },
  "optionalDependencies": {
    "@baerae/zkap-zkp-node-darwin-x64": "0.1.0",
    "@baerae/zkap-zkp-node-darwin-arm64": "0.1.0",
    "@baerae/zkap-zkp-node-linux-x64-gnu": "0.1.0",
    "@baerae/zkap-zkp-node-linux-x64-musl": "0.1.0"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18",
    "@swc-node/register": "^1.10.0",
    "@swc/core": "^1.7.0",
    "ava": "^6.1.3",
    "typescript": "^5.4.5"
  },
  "ava": {
    "extensions": {
      "ts": "module"
    },
    "nodeArguments": [
      "--import=@swc-node/register/esm-register"
    ],
    "files": [
      "__test__/**/*.spec.ts"
    ],
    "timeout": "10m"
  }
}
