{
  "name": "@baerae/zkap-zkp-sdk-node",
  "version": "0.1.5",
  "description": "Node.js native bindings for zkap-zkp (napi-rs)",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts"
  ],
  "napi": {
    "binaryName": "zkap-zkp-node",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl"
    ]
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "zk",
    "groth16",
    "poseidon",
    "zkap",
    "napi",
    "native"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baerae-zkap/zkap-zkp-sdk.git",
    "directory": "packages/sdk-node"
  },
  "homepage": "https://github.com/baerae-zkap/zkap-zkp-sdk",
  "bugs": "https://github.com/baerae-zkap/zkap-zkp-sdk/issues",
  "license": "MIT OR Apache-2.0",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "test": "ava",
    "test:bdd": "mocha --node-option=import=tsx/esm --extension ts \"test-bdd/**/*.spec.ts\"",
    "test:all": "npm run test && npm run test:bdd"
  },
  "optionalDependencies": {
    "@baerae/zkap-zkp-sdk-node-darwin-arm64": "0.1.5",
    "@baerae/zkap-zkp-sdk-node-darwin-x64": "0.1.5",
    "@baerae/zkap-zkp-sdk-node-linux-x64-gnu": "0.1.5",
    "@baerae/zkap-zkp-sdk-node-linux-x64-musl": "0.1.5"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18",
    "@swc-node/register": "^1.10.0",
    "@swc/core": "^1.7.0",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.41",
    "ava": "^6.1.3",
    "chai": "^5.3.3",
    "mocha": "^10.8.2",
    "tsx": "^4.22.1",
    "typescript": "^5.4.5"
  },
  "ava": {
    "extensions": {
      "ts": "module"
    },
    "nodeArguments": [
      "--import=@swc-node/register/esm-register"
    ],
    "files": [
      "__test__/**/*.spec.ts"
    ],
    "timeout": "10m"
  }
}
